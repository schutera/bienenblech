# --- Bienenblech production secrets & settings ---
# Copy this file to `.env` and fill it in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env

# Signing key for the login session cookie. Restarts stay logged in as long as
# this is stable; change it and every annotator is logged out. Generate one with:
#   openssl rand -hex 32
BIENENBLECH_SECRET=

# Bootstrap admin account — created on FIRST boot only, when the users table is
# empty. Once any user exists this is ignored, so changing it later does nothing:
# manage accounts in the Admin page instead. Change the password after first login.
BIENENBLECH_ADMIN_USER=admin
BIENENBLECH_ADMIN_PASSWORD=

# Public address the bundled Caddy serves on (docker-compose.yml only):
#   - a domain (e.g. bienenblech.schutera.com) -> automatic HTTPS via Let's Encrypt
#     (point the domain's DNS A/AAAA record at this server first)
#   - ":80"                                   -> plain HTTP only (testing)
# config/bienenblech.prod.yaml already ships `auth.https_only: true`, which is
# what you want behind a real domain. If you run plain HTTP (":80"), set it to
# false there — the browser will not send a Secure cookie over HTTP, and the
# login silently loops back to the login page.
CADDY_SITE_ADDRESS=:80

# Loopback port used ONLY by the co-tenancy override (docker-compose.shared.yml),
# where this stack has no Caddy of its own and another proxy on the same host
# forwards to 127.0.0.1:<this port>. Ignored by the standalone stack. Change it if
# 8001 is already taken on the box.
BIENENBLECH_PORT=8001

# Discord webhook the periodic backup posts to (turned on with `backup.enabled:
# true` in config/bienenblech.prod.yaml). OPTIONAL: leaving it blank — or leaving
# the line out entirely — is a supported state, not an error. The backup still
# runs, zips and rotates under data/backups/; it just posts nothing. For the same
# reason it must NOT be wired into docker-compose's `environment:` as
# ${BIENENBLECH_DISCORD_WEBHOOK:?}, which would turn an unset webhook into a hard
# boot failure; `env_file: .env` already injects it when it is set.
#
# Point it at a channel chosen for this. The zip contains the whole label store —
# annotator usernames, every mask, and the source images themselves — and the
# first run posts all of it at once.
#
# This URL is a credential: anyone holding it can post to the channel. `.env` is
# gitignored — never commit it, and never move this value into a YAML under
# config/, which IS committed and is bind-mounted into the container read-only.
BIENENBLECH_DISCORD_WEBHOOK=
